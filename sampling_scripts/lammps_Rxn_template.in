#############################################################################################################
## workflow control involving funcs above
#############################################################################################################

#############################################################################################################
## formal preparation ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
python touch_hills invoke

python convert_lmpdata_to_pdb invoke

python make_local_division invoke

python distinguish_local_global invoke

python split_avepdb_local_pdbs invoke

python merge_sep_ref_pdb_integrated_pdb invoke

python revise_multirmsd_avepdb invoke

python add_command_lmpptr invoke

## some dump relies on funcs above, so all dump settings are placed down here
dump            dpgen_dump all custom ${THERMO_FREQ} traj.dump id type x y z
dump            2 all custom ${PACE} ave.dump id type f_2[1] f_2[2] f_2[3] ## dump average
dump_modify     2 colname 3 x
dump_modify     2 colname 4 y
dump_modify     2 colname 5 z
dump_modify     dpgen_dump sort id
dump_modify     2 sort id

# dpgen2 forces match checking of "fix dpgen_plm" if lmp_template_fname and plm_template_fname is activated in dpgen2_param.json,
# here we use custom settings, so mute the standard fix dpgen_plm after checking (and default revise of the fix by dpgen2) 
fix             dpgen_plm all plumed plumedfile input.plumed outfile output.plumed
unfix           dpgen_plm

python delete_avepdb_back_from_dpgen_workaround invoke
## end of formal preparation ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
############################################################################################################


############################################################################################################
## loop of the metaD, by restarting plumed run and revising files to custom CV and refs ~~~~~~~~~~~~~~~~~~~~
## The first loop is an unbiased relaxation segment: no PLUMED fix is attached, 
## but provides equilibrium geometric infos for bonding_change analysis in later loops.
## From the second loop onward, PLUMED is re-attached for one PACE segment at a time, 
## inheriting the revised files recording hill center and ref geometries.
## The dump/ref-PDB/HILLS/COLVAR files are adapted with helper functions.
## LOOP number is self-adaptively determined in add_command_lmpptr by evaluation using HILL_HEIGHT and EXPECT_NUMB_REACT_INSTANCE.

variable loop_index loop ${LOOP}
label loop_start_here

# utilize PLUMED 'multi_rmsd' with modified files to implement the metric calculation
# PLUMED template is initialized with 'rmsd' to compatible with single-reference run of sigle local-division cases
# 1) for multiple local-division cases, revise PLUMED input at the begining
# 2) for single local-division cases, revise PLUMED input after accumulating multiple whole-molecule references after several runs

# cases 1) multiple local-division
if "${loop_index} == 1 && ${NUM_LOCAL_DIVISIONS} > 1" then &
"python revise_plumed_in_single_to_multi invoke"

# cases 2) single local-division
if "${loop_index} == 4 && ${NUM_LOCAL_DIVISIONS} == 1"  then &
"python revise_plumed_in_single_to_multi invoke"

# attach PLUMED for metaD after the first unbiased MD segment.
if "${loop_index} > 1 " then &
"fix           999 all plumed plumedfile input.plumed outfile output.plumed" &
"fix_modify    999 energy no"

run            ${PACE}

# detach PLUMED after each biased segment then to revise related files for the next segment
if "${loop_index} > 1" then &
"unfix         999"

# convert the latest time-averaged local reference geometries and merge them into the integrated reference file ave.pdb
python convert_lmpdump_to_pdb invoke
python merge_sep_ref_pdb_integrated_pdb invoke

# update HILLS records with respect to the expanding list of references, and format adaption
if "${loop_index} >= 2" then &
"python revise_cv_HILLS invoke"

# file-format adaption for case 2) when switching from 'rmsd' to 'multi_rmsd'
if "${loop_index} == 3 && ${NUM_LOCAL_DIVISIONS} == 1" then &
"python revise_columnames invoke"

# file-format synchronization and files backup every loop
python revise_multirmsd_avepdb invoke
python combine_bck_file invoke

next loop_index

jump SELF loop_start_here
## end metaD loop  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
##############################################################################################################


##############################################################################################################
## downstream TS opt branches ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

#select de-duplicated near-reactive seeds from metaD traj
python snapshots_from_traj invoke
#start local servers to load deepmd models then run batch dimer TS opt jobs via serve-client communications
python boost_deepmd_multi_server invoke
python run_dimer_batch_for_lammps invoke

#convert to expected dump files
python convert_xyz_lmpdump_deepmdnpymixed invoke
python get_model_devi invoke
python merge_model_devi invoke
python merge_traj invoke
## end of TS opt ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
