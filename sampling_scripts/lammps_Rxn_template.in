# Global DeepMD model cache to avoid reloading models
# This prevents the "operator already registered" error
_DEEPMD_MODEL_CACHE = {}

def get_deepmd_model(model_file, use_server=True, num_servers=4, server_client_dir="/opt", base_port=50001):
    # Get or create a DeepMD model instance using multi-server
    # This ensures each model file is loaded only once per server
    # Note: the current LAMMPS dimer workflow always requests use_server=True.
    # use_server=False is retained only as a legacy helper path, not as an exposed workflow option.
    global _DEEPMD_MODEL_CACHE
    import os
    import sys
    
    server_client_dir = os.path.abspath(os.path.expanduser(server_client_dir))
    cache_key = f"{model_file}_{use_server}_{num_servers}_{server_client_dir}_{base_port}"
    
    # Return cached client if available
    if cache_key in _DEEPMD_MODEL_CACHE:
        print(f"Using cached DeepMD model: {cache_key}")
        return _DEEPMD_MODEL_CACHE[cache_key]
    
    # Try multi-server mode first if requested
    if use_server:
        try:
            # Import multi-server client
            if server_client_dir not in sys.path:
                sys.path.insert(0, server_client_dir)
            from deepmd_client import create_multi_server_client
            
            print(f"Creating multi-server DeepMD client with {num_servers} servers from {server_client_dir}")
            client = create_multi_server_client(num_servers=num_servers, base_port=base_port)
            
            # Cache the client
            _DEEPMD_MODEL_CACHE[cache_key] = client
            return client
            
        except Exception as e:
            print(f"Failed to create multi-server client: {e}")
            print("Server-client mode requested; direct model fallback is disabled.")
            raise
    
    # Legacy direct loading path (not used by the current LAMMPS dimer workflow)
    # Check if this is model.000.pth which LAMMPS already loaded
    # If so, create a copy to avoid PyTorch operator re-registration
    if model_file == "model.000.pth":
        # Create a unique copy for Python/ASE use
        import shutil
        copy_name = "model.000_dimer.pth"
        
        if not os.path.exists(copy_name):
            shutil.copy2(model_file, copy_name)
            print(f"Created model copy: {copy_name} to avoid conflicts with LAMMPS")
        
        model_file = copy_name
    
    if model_file not in _DEEPMD_MODEL_CACHE:
        try:
            from deepmd.calculator import DP
            _DEEPMD_MODEL_CACHE[model_file] = DP(model=model_file)
            print(f"Loaded DeepMD model: {model_file}")
        except Exception as e:
            print(f"Error loading DeepMD model {model_file}: {e}")
            raise
    
    return _DEEPMD_MODEL_CACHE[model_file]

# Load the coordinates using dpdata
def load_coordinates(file_path):
        system = dpdata.System(file_path)
        return system["coords"][0]

# Calculate the geometric center of the molecule
def calculate_center(coordinates, indices):
        selected_coords = coordinates[indices]
        return np.mean(selected_coords, axis=0)

# Calculate the distance between two points
def distance(point1, point2):
        return np.linalg.norm(point1 - point2)

# Create a division based on the cutoff radius
def create_division(coordinates, reference_index, rcut, assigned_indices):
        division = []
        for i, coord in enumerate(coordinates):
                if i not in assigned_indices and distance(coordinates[reference_index], coord) <= rcut:
                        division.append(i)
                        assigned_indices.add(i)
        return division

# Merge single-atom divisions into the nearest division
def merge_single_atom_divisions(divisions, coordinates, secure_distance):
        for i, division in enumerate(divisions):
                if len(division) == 1:
                        single_atom_index = division[0]
                        min_distance = float('inf')
                        nearest_division_index = -1
                        for j, other_division in enumerate(divisions):
                                if i != j:
                                        for atom_index in other_division:
                                                dist = distance(coordinates[single_atom_index], coordinates[atom_index])
                                                if dist < min_distance and dist <= secure_distance:
                                                        min_distance = dist
                                                        nearest_division_index = j
                        if nearest_division_index != -1:
                                divisions[nearest_division_index].append(single_atom_index)
                                divisions[i] = []
        return [division for division in divisions if division]


def make_division_plus_one_dropHydrogen (file_path,divisions,type_map=["H","C","N","O","F","P","S","Cl"]):
        system=dpdata.System(file_path,type_map=type_map)
        print(divisions)
        ele_idx=system["atom_types"]
        ele_names=np.array(type_map)[ele_idx]

        divisions_plus_one = [[x + 1 for x in sublist if ele_names[x] != "H" ] for sublist in divisions]
        divisions_plus_one = [division for division in divisions_plus_one if len(division) > 0 ]

        return divisions_plus_one


# Main function to divide the molecule
def make_local_division(file_path, rcut, secure_distance=1.9, drop_hydrogen_rcut_largerthan=1.3, type_map="H,C,N,O,F,P,S,Cl"):
        coordinates = load_coordinates(file_path)
        #print(coordinates)
        total_indices = set(range(len(coordinates)))
        assigned_indices = set()
        divisions = []

        # Start with a random atom for the first division
        first_reference_index = random.choice(list(total_indices))
        division = create_division(coordinates, first_reference_index, rcut, assigned_indices)
        divisions.append(division)

        while assigned_indices != total_indices:
                remaining_indices = list(total_indices - assigned_indices)
                if len(remaining_indices) == 1:
                        # Merge the last remaining atom with the nearest division
                        single_atom_index = remaining_indices[0]
                        min_distance = float('inf')
                        nearest_division_index = -1
                        for i, division in enumerate(divisions):
                                for atom_index in division:
                                        dist = distance(coordinates[single_atom_index], coordinates[atom_index])
                                        if dist < min_distance and dist <= secure_distance:
                                                min_distance = dist
                                                nearest_division_index = i
                        if nearest_division_index != -1:
                                divisions[nearest_division_index].append(single_atom_index)
                                assigned_indices.add(single_atom_index)
                        break

                center = calculate_center(coordinates, remaining_indices)
                furthest_index = remaining_indices[np.argmax([distance(center, coordinates[i]) for i in remaining_indices])]
                division = create_division(coordinates, furthest_index, rcut, assigned_indices)

                divisions.append(division)

        # Merge single-atom divisions into the nearest division
        divisions = merge_single_atom_divisions(divisions, coordinates, secure_distance)

        #divisions = [[1,4,6,7,0],[2,5],[3,8]]
        if rcut >= drop_hydrogen_rcut_largerthan:
                print(">=")
                type_map=type_map.split(",")
                print(type_map)
                divisions_plus_one = make_division_plus_one_dropHydrogen (file_path,divisions,type_map)
        else:
                divisions_plus_one = [[x + 1 for x in sublist] for sublist in divisions]
        print(divisions_plus_one)
        with open("divisions.json","w") as fo:
                json.dump(divisions_plus_one,fo)



def convert_lmpdata_to_pdb(dump_file_name="conf.lmp", outfile_name_prefix="ave_pre",type_map="H,C,N,O,F,P,S,Cl"):

        # Read LAMMPS data file with the correct atom_style
        #u = mda.Universe(dump_file_name, format='DATA', atom_style='id type x y z')
        u = mda.Universe(dump_file_name, format='DATA', atom_style='id type x y z')

        type_list = type_map.split(",")
        type_to_element = {str(i+1): elem for i, elem in enumerate(type_list)}
        #type_to_element = {
        #    '1': 'H',
        #    '2': 'C',
        #    '3': 'N',
        #    '4': 'O',
        #    '5': 'F',
        #    '6': 'P',
        #    '7': 'S',
        #    '8': 'Cl'
        #}

        # Set the elements attribute based on the types
        elements = np.array([type_to_element[atype] for atype in u.atoms.types])
        u.add_TopologyAttr('names', elements)

        #print(u.atoms.types)
        # Write all frames to the PDB file
        pdb_file = f"{outfile_name_prefix}_0.pdb"
        with mda.Writer(pdb_file, u.atoms.n_atoms, multiframe=True, reindex=False) as w:
                for ts in u.trajectory:
                        w.write(u.atoms)
        # Clean the PDB file to remove unwanted header lines using sed
        os.system(f"sed -i '/^HEADER/d;/^TITLE/d;/^REMARK/d' {pdb_file}")

        # Reload the PDB file to set bfactors
        u = mda.Universe(pdb_file, format='PDB')

        for ts in u.trajectory:
                u.atoms.tempfactors = np.ones(u.atoms.n_atoms)  # Set bfactor to 1.0 for all atoms

        # Write the modified PDB file
        modified_pdb_file = f"{outfile_name_prefix}.pdb"
        with mda.Writer(modified_pdb_file, u.atoms.n_atoms, multiframe=True, reindex=False) as w:
                #for ts in u.trajectory:
                w.write(u.atoms)

        # Clean the PDB file to remove unwanted header lines using sed
        os.system(f"sed -i '/^HEADER/d;/^TITLE/d;/^REMARK/d' {modified_pdb_file}")

 
def split_avepdb_local_pdbs (input_file="ave_pre.pdb", divisions="divisions.json"):
        with open(divisions, 'r') as fi:
                div_list = json.load(fi)
        with open(input_file, 'r') as f:
                lines = f.readlines()
        #print(lines) 
        # Extract header (CRYST1 and MODEL)
        header = [line for line in lines if line.startswith(('CRYST1', 'MODEL'))]
        atoms = [line for line in lines if line.startswith('ATOM')]
        footer = [line for line in lines if line.startswith('ENDMDL')]
        # Split atoms into groups
        for i, indices in enumerate(div_list, 1):
                print(i,indices)
                output_file = f"ave_local_{i}.pdb"
                with open(output_file, 'w') as f:
                        f.writelines(header)
                        for idx in indices:
                                print(idx)
                                if int(idx)-1 < len(atoms):  # Adjust for 1-based indexing
                                        f.write(atoms[int(idx)-1])
                        f.writelines(footer)
                        print(footer)
                print(f"Created {output_file}")


def convert_lmpdump_to_pdb (divisions="divisions.json",type_map="H,C,N,O,F,P,S,Cl"):
        type_list = type_map.split(",")
        type_to_element = {str(i+1): elem for i, elem in enumerate(type_list)}
        #type_to_element = {
        #    '1': 'H',
        #    '2': 'C',
        #    '3': 'N',
        #    '4': 'O',
        #    '5': 'F',
        #    '6': 'P',
        #    '7': 'S',
        #    '8': 'Cl'
        #}

        with open(divisions, 'r') as fi:
                div_list = json.load(fi)

        for idx,val in enumerate (div_list):
                suffix=str(int(idx+1))
                outfile_name_prefix="ave_local_"+suffix
                dump_file_name = outfile_name_prefix + ".dump"

                # Read LAMMPS data file with the correct atom_style
                #u = mda.Universe(dump_file_name, format='DATA', atom_style='id type x y z')
                u = mda.Universe(dump_file_name, format='LAMMPSDUMP', atom_style='id type x y z')

                # Set the elements attribute based on the types
                elements = np.array([type_to_element[atype] for atype in u.atoms.types])
                u.add_TopologyAttr('names', elements)

                if len(u.trajectory) > 1:
                        u.trajectory[-1]

                #print(u.atoms.types)
                # Write all frames to the PDB file
                pdb_file = f"pre_{outfile_name_prefix}.pdb"
                with mda.Writer(pdb_file, u.atoms.n_atoms, multiframe=True, reindex=False) as w:
                        w.write(u.atoms)
                # Clean the PDB file to remove unwanted header lines using sed
                os.system(f"sed -i '/^HEADER/d;/^TITLE/d;/^REMARK/d' {pdb_file}")

                # Reload the PDB file to set bfactors
                uu = mda.Universe(pdb_file, format='PDB')

                for ts in uu.trajectory:
                        uu.atoms.tempfactors = np.ones(uu.atoms.n_atoms)  # Set bfactor to 1.0 for all atoms

                append_pdb_file=outfile_name_prefix+".pdb"
                # the first retained ave is the third record, overwrite till it. 
                # first: all-0-coordinate record as the initialization of the lammps dump before all runs; 
                # second: the averaged geometry during first unbiased MD segment; 
                # third: the averaged geometry during the first PLUMED metaD segment, but with an empty HILLS files that exerts no bias (PLUMED 'rmsd' implementation), 
                # therefore, the third record is still an equilibrium averaged geometry, and being used as the first time-referenced reference.
                if len(u.trajectory) <= 3:    
                        with mda.Writer(append_pdb_file, uu.atoms.n_atoms, multiframe=True, reindex=False) as w:
                                w.write(uu.atoms)

                if len(u.trajectory) > 3:
                        #os.system(f"sed -i '/^END/d' {append_pdb_file}")
                        with open(append_pdb_file, 'a') as f:
                                with mda.Writer(f, uu.atoms.n_atoms, multiframe=True, reindex=False, format='PDB') as w:
                                        w.write(uu.atoms)

                os.system(f"sed -i '/^END$/d' {append_pdb_file}")
                os.system(f"sed -i '/^HEADER/d;/^TITLE/d;/^REMARK/d' {append_pdb_file}")



def merge_sep_ref_pdb_integrated_pdb (prefix_wildcard="ave_local_*.pdb", outputfile="ave.pdb"):
        files = sorted(glob.glob(prefix_wildcard))

        with open(outputfile, "w") as outfile:
                for file in files:
                        with open(file, "r") as infile:
                                outfile.write(infile.read())


def revise_cv_HILLS(filename="HILLS",divisions="divisions.json"):
        # we keep the spacing and format of the original HILLS
        with open(filename, "r") as f:
                lines = f.readlines()

        modified_lines=str()
        CV_index=0

        #reference_universe=Universe(reference)
        #target_universe=Universe(reference)

        for line in lines:
                if (line.strip()==False) or line.startswith("#"):  # Skip empty lines and comments
                        modified_lines += line
                else:
                        fields = line.split()
                        line_out=str()

                        if CV_index == 0 :
                                format_space=[] # here is the format definition for each field in a data row
                                raw_line_len=len(line)

                                for index,content in enumerate (fields):
                                        split = line.split(maxsplit=index) #space for field is calculated by the len diff between different split
                                        len_split = len (split[-1])

                                        if index == 0:
                                                space = raw_line_len - len_split + len(fields[index])
                                                format_space.append(space)
                                        elif index > 0:
                                                split_former = line.split(maxsplit=(index-1))
                                                len_split_former = len (split_former[-1])
                                                len_field = -len (fields[index-1]) + len (fields[index])
                                                space = len_split_former - len_split + len_field
                                                format_space.append(space)

                                        if index != 1:
                                                line_out += '{:>{width}}'.format(fields[index],width=format_space[index])
                                        else:
                                                #UPDATE CV
                                                updated_CV = str(update_CV(CV_index,last_CV=fields[index],divisions=divisions))
                                                line_out += '{:>{width}}'.format(updated_CV,width=format_space[index])

                                        if index == len(fields)-1 :
                                                line_out += f"\n"
                                modified_lines += line_out
                                CV_index += 1

                        elif CV_index >=1 :
                                for index,content in enumerate (fields):
                                        if index ==1 :
                                                #UPDATE CV
                                                fields[index] = str(update_CV(CV_index,last_CV=fields[index],divisions=divisions))
                                        line_out += '{:>{width}}'.format(fields[index],width=format_space[index])
                                        if index == len(fields)-1 :
                                                line_out += f"\n"
                                modified_lines += line_out
                                CV_index += 1

        with open(filename, "w") as fo:
                fo.writelines(modified_lines)


def update_CV (CV_index,last_CV,divisions):

        new_msd_global = 0
        old_sum_MSD = np.square(float(last_CV))
        sum_msd_divisions = 0

        with open (divisions) as fi:
                div_list=json.load(fi)

        for local_idx,val in enumerate(div_list):
                reference = "ave_local_"+str(int(local_idx)+1)+".pdb"
                reference_universe=Universe(reference)
                target_universe=Universe(reference)
                total_reference_number = len (reference_universe.trajectory)
                target_universe.trajectory[CV_index]
                if (CV_index +1) == total_reference_number:
                        sum_msd_align = 0
                        for idx in range (total_reference_number) :
                                reference_universe.trajectory[idx]  # set the reference frame                     
                                rmsd_orig,rmsd_align = align.alignto(reference_universe,target_universe,match_atoms=True,weights=None)
                                msd_align = np.square(rmsd_align)
                                sum_msd_align += msd_align
                        sum_msd_divisions += sum_msd_align

                else :
                        #recursively using the previous SD as recovered from the last_CV
                        reference_universe.trajectory[-1] #set reference 
                        rmsd_orig,rmsd_align = align.alignto(reference_universe,target_universe,match_atoms=True,weights=None)
                        msd_align = np.square (rmsd_align)
                        sum_msd_divisions += msd_align

        if (CV_index +1) == total_reference_number:
                new_msd_global =sum_msd_divisions

        else:
                new_msd_global = old_sum_MSD+sum_msd_divisions

        new_CV = np.sqrt(new_msd_global)

        return (new_CV)


def revise_multirmsd_avepdb (file_in="ave.pdb",file_out="ave_multiRMSD.pdb"):
        os.system("cp %s %s" %(file_in,file_out))
        command_list=["sed -i '/^MODEL/d' %s" %file_out, "sed -i 's/ENDMDL/TER/g' %s" %file_out, "sed -i '$s/TER/END/' %s" %file_out]
        for command in command_list:
                os.system(command)

def revise_columnames (file1="HILLS",file2="COLVAR"):
        os.system("sed -i 's/rmsd/multi_rmsd/g' %s" %file1)
        os.system("sed -i 's/rmsd/multi_rmsd/g' %s" %file2)

def combine_bck_file (prefix_bck="bck.*.plumed.out", combined_file_name="bck_combined.plumed.out"):
        for bck_file in glob.glob(prefix_bck):
                os.system("cat %s >> %s && rm %s" %(bck_file,combined_file_name,bck_file))

def delete_avepdb_back_from_dpgen_workaround (file="ave.pdb"):
        os.system("rm %s" %file)

def revise_plumed_in_single_to_multi (file="input.plumed"):
        os.system("sed -i 's/RMSD/MULTI_RMSD/g' %s" %file)
        os.system("sed -i 's/rmsd/multi_rmsd/g' %s" %file)
        os.system("sed -i 's/OPTIMAL/MULTI-OPTIMAL/g' %s" %file)
        os.system("sed -i 's/ave.pdb/ave_multiRMSD.pdb/g' %s" %file)


def touch_hills (any):  #####seems new version plumed will check the existence of HILLS when reading restart
	os.system("touch HILLS")



