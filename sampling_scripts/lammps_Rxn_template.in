# metaD with plumed and in-line python

variable        TEMP equal V_TEMP
variable        PACE equal V_PACE
variable        HILL_HEIGHT string V_HILL_HEIGHT
variable        HILL_SIGMA  string V_HILL_SIGMA
variable        EXPECT_NUMB_REACT_INSTANCE equal V_EXPECT_NUMB_REACT_INSTANCE
#variable       LOOP equal ceil(4.6*0.8/${HILL_HEIGHT}*${EXPECT_NUMB_REACT_INSTANCE})+2 # self-adaptively controlling the length of the simulation, by approximately evaluating how many hills (in ideal) will be needed to break a C-C single bond around 80 kcal/mol = 4.6*0.8 eV, will be added by func add_command_lmpptr
variable        HARMONIC_THICKNESS equal V_HARMONIC_THICKNESS
variable        HARMONIC_FACTOR equal V_HARMONIC_FACTOR
variable        TIME_STEP equal V_TIME_STEP
variable        THERMO_FREQ     equal V_OUTFREQ_PLUMED
variable        MASS_HYDROGEN equal V_MASS_HYDROGEN
variable        LOCAL_RCUT equal V_LOCAL_RCUT
variable        SECURE_SINGLE_ATOM_RCUT equal V_SECURE_SINGLE_ATOM_RCUT
variable        Nrepeats string V_Nrepeats
variable        DROP_HYDROGEN_RCUT_LARGERTHAN equal V_DROP_HYDROGEN_RCUT_LARGERTHAN
variable        NUM_LOCAL_DIVISIONS python distinguish_local_global


units           metal
boundary        p p p 
atom_style      atomic

neighbor        2.0 bin
neigh_modify    every 10 delay 0 check no

read_data conf.lmp

mass             1 ${MASS_HYDROGEN} # mass of H revise to heavier values
mass             2 12
mass             3 14
mass             4 15
mass             5 19
mass             6 31
mass             7 32
mass             8 35

pair_style      deepmd model.000.pth model.001.pth model.002.pth model.003.pth out_freq ${THERMO_FREQ} out_file model_devi.out
pair_coeff  * *	

#define the nanoreactor
variable        sphere_r equal 0.5*lx
region          reactor sphere v_sphere_r v_sphere_r v_sphere_r v_sphere_r side in units box 
fix             reactor_wall all wall/region reactor harmonic ${HARMONIC_FACTOR} 0.0 ${HARMONIC_THICKNESS}
#end of nanoreactor

velocity        all create ${TEMP} 240411

fix             1 all nvt temp ${TEMP} ${TEMP} 0.1
#fix            2 all ave/atom 1 ${Nrepeats} ${PACE} x y z  # for time-averaged reference, will be set by func add_commnad_lmptr
fix             momenta all momentum 100 angular rescale

timestep        ${TIME_STEP}
thermo_style    custom step pe ke etotal temp press vol
thermo          ${THERMO_FREQ}

restart         10000 dpgen.restart

